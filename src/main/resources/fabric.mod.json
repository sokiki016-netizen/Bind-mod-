		"sources": "https://github.com/sokiki016-netizen/Bind-mod-"
	},
	"license": "CC0-1.0",
	"icon": "assets/bindmod/icon.png",
	"environment": "client",
	"entrypoints": {
		"client": [
			"com.sokiki.bindmod.BindModClient"
		]
	},
	"depends": {
		"fabricloader": ">=0.16.0",
		"minecraft": "~1.21.4",
		"java": ">=21",
		"fabric-api": "*"
	}
